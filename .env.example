# PIPEOX configuration — copy to .env (or run `npm run setup`, which does it for you).
# Never commit .env: it holds secrets.

NODE_ENV=production
# Port of the website (production server)
PORT=4000
# Port of the API during development (npm run dev)
API_PORT=3000
# Public address, no trailing slash — canonical URLs, sitemap, password-reset emails
SITE_URL=

# Database: local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/pipeox

# Session signing key, 32+ random characters (generated by npm run setup)
JWT_SECRET=
# Admin password hash (generated by npm run setup / npm run admin:password)
ADMIN_PASSWORD_HASH=

# Uploaded images and inquiry attachments — keep outside the app folder and back it up
DATA_DIR=../pipeox-data
# Set to 1 when running behind nginx / a hosting panel proxy (correct client IPs for rate limits)
TRUST_PROXY=0

# ── Email (SMTP) — new-inquiry alerts and customer password reset ──
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL_TO=

# ── Bale bot (reachable from Iranian servers) ──
BALE_BOT_TOKEN=
BALE_CHAT_ID=
# ── Telegram bot (usually blocked from servers inside Iran) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Online payment (Shaparak bank gateways) ──
# Each gateway is offered to customers once its credentials (from the bank contract) are set.
# The callback address to register with the bank: SITE_URL/api/payments/<mellat|saman|sadad>/callback
# Bank Mellat (Behpardakht)
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
# Bank Saman (SEP)
SAMAN_TERMINAL_ID=
# Bank Melli (Sadad) — the merchant key is the Base64 key from the bank
SADAD_MERCHANT_ID=
SADAD_TERMINAL_ID=
SADAD_KEY=
# Test gateway (approve/cancel without a bank) for development only; refused in production
PAYMENT_SANDBOX=false
