    The body is HTML sanitized on save in the admin panel. -#}
<?php $a = $P['article']; ?>
<section class="section section-tight">
  <div class="wrap article-grid">
    <article class="prose">
      <p class="article-meta"><?php if ($a['category']): ?><span class="tag"><?= e($a['category']) ?></span> <?php endif ?><time datetime="<?= e($a['published_at']) ?>"><?= fa_date($a['published_at']) ?></time> · <?= reading_time($a['body']) ?> دقیقه مطالعه</p>
      <?php if ($a['image'] && $a['show_cover']): ?><img class="article-cover" src="<?= e($a['image']) ?>" alt="<?= e($a['image_alt']) ?>" decoding="async"><?php endif ?>
      <?= $a['body'] ?>
    </article>
    <aside class="article-side">
      <div class="side-card">
        <b>استعلام با اطلاعات فنی کامل</b>
        <p>لیست متریال یا دیتاشیت پروژه را ارسال کنید تا کارشناسان ما بررسی کنند.</p>
        <a class="btn" href="/contact/" data-quote-open>ثبت درخواست ←</a>
      </div>
      <?php $more = array_filter(articles(8), fn($x) => $x['slug'] !== $a['slug']); ?>
      <?php if ($more): ?>
      <div class="side-card">
        <b>مطالب دیگر</b>
        <ul>
          <?php foreach ($more as $m): ?><li><a href="/insights/<?= e($m['slug']) ?>/"><?= e($m['title']) ?></a></li><?php endforeach ?>
        </ul>
      </div>
      <?php endif ?>
    </aside>
  </div>
</section>
