<?php $o = $P['old']; $bad = fn($f) => $P['field'] === $f ? ' aria-invalid="true"' : ''; ?>
<section class="section section-tight">
  <div class="wrap auth-wrap">
    <form class="auth-card glass" method="post" novalidate>
      <h2>ثبت‌نام</h2>
      <?php if ($P['error']): ?><p class="notice notice-error" role="alert"><?= e($P['error']) ?></p><?php endif ?>
      <?= csrf_field() ?>
      <label class="field">{{ icon("user") }}<input name="name" placeholder="نام و نام خانوادگی" aria-label="نام و نام خانوادگی" autocomplete="name" maxlength="100" required value="<?= e($o['name']) ?>"<?= $bad('name') ?>></label>
      <label class="field">{{ icon("mail") }}<input type="email" name="email" dir="ltr" placeholder="ایمیل" aria-label="ایمیل" autocomplete="email" maxlength="190" required value="<?= e($o['email']) ?>"<?= $bad('email') ?>></label>
      <label class="field">{{ icon("phone") }}<input type="tel" name="phone" inputmode="tel" placeholder="شماره تماس" aria-label="شماره تماس" autocomplete="tel" maxlength="30" required value="<?= e($o['phone']) ?>"<?= $bad('phone') ?>></label>
      <label class="field">{{ icon("list") }}<input name="company" placeholder="شرکت / سازمان (اختیاری)" aria-label="شرکت یا سازمان" autocomplete="organization" maxlength="150" value="<?= e($o['company']) ?>"></label>
      <label class="field">{{ icon("shield") }}<input type="password" name="password" placeholder="رمز عبور (حداقل ۸ کاراکتر)" aria-label="رمز عبور" autocomplete="new-password" minlength="8" required<?= $bad('password') ?>></label>
      <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
      <button class="btn btn-block" type="submit"><span>ساخت حساب</span></button>
      <div class="auth-links"><span>حساب دارید؟ <a href="/account/login/">وارد شوید</a></span></div>
    </form>
