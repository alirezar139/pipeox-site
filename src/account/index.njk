---
layout: layouts/page.njk
permalink: /account/index.php
controller: account
private: true
title: حساب من
eyebrow: CUSTOMER ACCOUNT
breadcrumbs:
  - { label: "خانه", url: "/" }
  - { label: "حساب من", url: "/account/" }
---
{%- from "partials/icons.njk" import icon -%}
<?php $me = $P['me']; ?>
<section class="section section-tight">
  <div class="wrap account-grid">
    <div class="account-main">
      <?php if ($P['flash']): ?><p class="notice notice-<?= e($P['flash'][1]) ?>"><?= e($P['flash'][0]) ?></p><?php endif ?>
      <?php if ($P['error']): ?><p class="notice notice-error" role="alert"><?= e($P['error']) ?></p><?php endif ?>

      <div class="account-head">
        <h2 class="sub-title">درخواست‌های من</h2>
        <a class="pill pill-orange" href="/contact/" data-quote-open>{{ icon("arrow") }}<span>استعلام جدید</span></a>
      </div>

      <?php if (!$P['inquiries']): ?>
      <div class="empty-card">
        <b>هنوز درخواستی ثبت نکرده‌اید.</b>
        <p>استعلام‌هایی که بعد از ورود ثبت کنید، این‌جا با وضعیتشان نمایش داده می‌شوند.</p>
      </div>
      <?php endif ?>

      <ol class="inq-list">
        <?php foreach ($P['inquiries'] as $q): ?>
        <li class="inq s-<?= e($q['status']) ?>">
          <div class="inq-top">
            <span class="inq-id">#<?= fa_digits($q['id']) ?></span>
            <span class="inq-status"><?= e(CUSTOMER_STATUSES[$q['status']] ?? $q['status']) ?></span>
          </div>
          <b><?= e($q['category'] ?: 'درخواست استعلام') ?></b>
          <?php if ($q['details']): ?><p><?= nl2br(e(excerpt($q['details'], 300))) ?></p><?php endif ?>
          <small><?= fa_date($q['created_at']) ?><?= $q['attachment_name'] ? ' · ' . e($q['attachment_name']) : '' ?></small>
        </li>
        <?php endforeach ?>
      </ol>
    </div>

    <aside class="account-side">
      <form class="side-card account-card" method="post" id="profile">
        <b>اطلاعات حساب</b>
        <p class="account-email" dir="ltr"><?= e($me['email']) ?></p>
        <?= csrf_field() ?>
        <input type="hidden" name="action" value="profile">
        <label class="field">{{ icon("user") }}<input name="name" placeholder="نام و نام خانوادگی" aria-label="نام و نام خانوادگی" maxlength="100" required value="<?= e($me['name']) ?>"></label>
        <label class="field">{{ icon("phone") }}<input type="tel" name="phone" placeholder="شماره تماس" aria-label="شماره تماس" maxlength="30" required value="<?= e($me['phone']) ?>"></label>
        <label class="field">{{ icon("list") }}<input name="company" placeholder="شرکت / سازمان" aria-label="شرکت یا سازمان" maxlength="150" value="<?= e($me['company']) ?>"></label>
        <button class="btn btn-block" type="submit"><span>ذخیره</span></button>
      </form>

      <form class="side-card account-card" method="post" id="password">
        <b>تغییر رمز عبور</b>
        <?= csrf_field() ?>
        <input type="hidden" name="action" value="password">
        <label class="field">{{ icon("shield") }}<input type="password" name="current" placeholder="رمز فعلی" aria-label="رمز فعلی" autocomplete="current-password" required></label>
        <label class="field">{{ icon("shield") }}<input type="password" name="password" placeholder="رمز جدید (حداقل ۸ کاراکتر)" aria-label="رمز جدید" autocomplete="new-password" minlength="8" required></label>
        <button class="btn btn-block btn-ghost" type="submit"><span>تغییر رمز</span></button>
      </form>

      <form method="post" class="logout-form">
        <?= csrf_field() ?>
        <input type="hidden" name="action" value="logout">
        <button type="submit" class="link-more">خروج از حساب</button>
      </form>
    </aside>
  </div>
</section>
