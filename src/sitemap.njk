{#- Served at /sitemap.xml (rewrite). Needs the site address (admin → settings). -#}
<?php
require_once {{ page.outputPath | phpRoot | safe }} . '/api/lib/site.php';
header('Content-Type: application/xml; charset=utf-8');
$urls = [['/', null], ['/products/', null], ['/projects/', null], ['/about/', null], ['/contact/', null], ['/insights/', null]];
foreach (products() as $p) { $urls[] = ['/products/' . $p['slug'] . '/', substr($p['updated_at'], 0, 10)]; }
foreach (articles() as $a) { $urls[] = ['/insights/' . $a['slug'] . '/', substr($a['updated_at'], 0, 10)]; }
echo '<?xml version="1.0" encoding="UTF-8"?>', "\n", '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">', "\n";
if (abs_url('/')) {
    foreach ($urls as [$path, $mod]) {
        echo '  <url><loc>', e(abs_url($path)), '</loc>', $mod ? "<lastmod>$mod</lastmod>" : '', "</url>\n";
    }
}
echo "</urlset>\n";
