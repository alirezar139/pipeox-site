{#-
  Root layout — output is PHP. Page front matter may set:
    permalink (…/index.php), title, description, eyebrow, heading, lead, breadcrumbs ([{label, url}]),
    bodyClass, ogType, controller (api/pages/<name>.php runs first), private (no-index, no-cache)
  A controller can override any of these at request time (e.g. product pages).
-#}
{%- set meta = {
  url: page.url | cleanUrl, title: title, description: description, eyebrow: eyebrow, heading: heading,
  lead: lead, breadcrumbs: breadcrumbs, ogType: ogType, controller: controller, private: private
} -%}
<?php
require_once {{ page.outputPath | phpRoot | safe }} . '/api/lib/site.php';
$P = page_start(json_decode(<<<'JSON'
{{ meta | dump | safe }}
JSON, true));
$desc = $P['description'] ?? s('site.description');
$absUrl = abs_url($P['url']);
?>
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0c0d0e">
  <title><?= e(page_title($P)) ?></title>
  <meta name="description" content="<?= e($desc) ?>">
  <?php if (!empty($P['private'])): ?><meta name="robots" content="noindex, nofollow"><?php endif ?>
  <?php if ($absUrl): ?>
  <link rel="canonical" href="<?= e($absUrl) ?>">
  <meta property="og:url" content="<?= e($absUrl) ?>">
  <meta property="og:image" content="<?= e(abs_url('/assets/img/og.jpg')) ?>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <?php endif ?>
  <meta property="og:type" content="<?= e($P['ogType'] ?? 'website') ?>">
  <meta property="og:title" content="<?= e(page_title($P)) ?>">
  <meta property="og:description" content="<?= e($desc) ?>">
  <meta property="og:site_name" content="<?= se('site.name') ?>">
  <meta property="og:locale" content="fa_IR">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/vazirmatn-arabic-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  <script>document.documentElement.classList.add("js")</script>
  <?php
  $ld = [];
  if ($P['url'] === '/') {
      $ld[] = array_filter([
          '@context' => 'https://schema.org', '@type' => 'Organization',
          'name' => s('site.name'), 'alternateName' => s('site.nameFa'), 'description' => s('site.description'),
          'url' => abs_url('/') ?: null, 'logo' => abs_url('/favicon.svg') ?: null,
          'email' => s('contact.email') ?: null, 'telephone' => s('contact.phone') ?: null, 'address' => s('contact.address') ?: null,
      ]);
  }
  if (!empty($P['breadcrumbs']) && abs_url('/')) {
      $ld[] = ['@context' => 'https://schema.org', '@type' => 'BreadcrumbList', 'itemListElement' => array_map(
          fn($c, $i) => ['@type' => 'ListItem', 'position' => $i + 1, 'name' => $c['label'], 'item' => abs_url($c['url'])],
          $P['breadcrumbs'], array_keys($P['breadcrumbs']))];
  }
  if (!empty($P['jsonld'])) {
      $ld[] = $P['jsonld'];
  }
  foreach ($ld as $obj): ?>
  <script type="application/ld+json"><?= json_encode($obj, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG) ?></script>
  <?php endforeach ?>
</head>
<body class="{{ bodyClass }}">
<a class="skip-link" href="#main">پرش به محتوای اصلی</a>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{%- if page.url != "/contact/index.php" %}
{% include "partials/quote-modal.njk" %}
{%- endif %}
<script src="/assets/js/main.js" defer></script>
</body>
</html>
