---
layout: layouts/base.njk
---
{#- Inner page: compact hero with breadcrumb, then content. Values come from $P (front matter or controller). -#}
<section class="page-hero">
  <div class="wrap">
    <?php if (!empty($P['breadcrumbs'])): $last = count($P['breadcrumbs']) - 1; ?>
    <nav class="breadcrumb" aria-label="مسیر صفحه">
      <?php foreach ($P['breadcrumbs'] as $i => $b): ?>
      <?php if ($i === $last): ?><span aria-current="page"><?= e($b['label']) ?></span><?php else: ?><a href="<?= e($b['url']) ?>"><?= e($b['label']) ?></a><i aria-hidden="true">/</i><?php endif ?>
      <?php endforeach ?>
    </nav>
    <?php endif ?>
    <?php if (!empty($P['eyebrow'])): ?><div class="eyebrow"><?= e($P['eyebrow']) ?></div><?php endif ?>
    <h1><?= e($P['heading'] ?? $P['title'] ?? '') ?></h1>
    <?php if (!empty($P['lead'])): ?><p class="lead"><?= e($P['lead']) ?></p><?php endif ?>
  </div>
</section>
{{ content | safe }}
