{#- Inquiry form. Posts to /api/inquiry.php; see src/api/. -#}
<aside class="quote" id="contact">
  <span class="small">با تیم فروش و فنی در ارتباط باشید</span>
  <h2>{{ formTitle or "درخواست مشاوره و استعلام" }}</h2>
  <p>مشخصات اولیه را ثبت کنید تا برای پیگیری درخواست با شما تماس بگیریم.</p>
  <form class="formgrid" id="quoteForm" action="/api/inquiry.php" method="post" enctype="multipart/form-data" data-phone="{{ site.contact.phone }}" novalidate>
    <input required name="name" autocomplete="name" placeholder="نام و نام خانوادگی" aria-label="نام و نام خانوادگی" maxlength="100">
    <input required name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" placeholder="شماره تماس" aria-label="شماره تماس" maxlength="30">
    <select class="wide" name="category" aria-label="گروه محصول موردنظر">
      <option value="">گروه محصول موردنظر</option>
      {%- for p in products %}
      <option{% if selectedProduct == p.title %} selected{% endif %}>{{ p.title }}</option>
      {%- endfor %}
      <option>تأمین پروژه</option>
    </select>
    <textarea class="wide" rows="3" name="details" placeholder="استاندارد، سایز، گرید، مقدار یا توضیح پروژه (اختیاری)" aria-label="توضیحات پروژه" maxlength="3000"></textarea>
    <label class="wide file-field">
      <input type="file" name="attachment" accept=".pdf,.xlsx,.xls,.docx,.doc,.csv,.jpg,.jpeg,.png">
      <span class="file-label" data-empty="📎 پیوست لیست متریال یا دیتاشیت (اختیاری)">📎 پیوست لیست متریال یا دیتاشیت (اختیاری)</span>
    </label>
    {#- Honeypot: hidden from people, bots fill it -#}
    <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
    <button class="btn" type="submit">ثبت درخواست ↗</button>
  </form>
  <div class="formnote">PDF، Excel، Word یا تصویر تا ۸ مگابایت · اطلاعات شما فقط برای پیگیری همین درخواست استفاده می‌شود.</div>
  <div class="status" id="formStatus" role="status" aria-live="polite" hidden></div>
</aside>
