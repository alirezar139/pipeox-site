{#- expects: p (product), idx (1-based) -#}
<article class="product" data-search="{{ p.keywords }}">
  <a class="visual" href="/products/{{ p.slug }}/" tabindex="-1" aria-hidden="true"><img src="/assets/img/{{ p.image }}" alt="{{ p.alt }}" loading="lazy" decoding="async"></a>
  <small>0{{ idx }} / {{ p.code }}</small>
  <h3><a href="/products/{{ p.slug }}/">{{ p.title }}</a></h3>
  <p>{{ p.summary }}</p>
  <a class="more" href="/products/{{ p.slug }}/">مشخصات و استعلام <span>←</span></a>
</article>
