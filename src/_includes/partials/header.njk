{%- from "partials/icons.njk" import icon -%}
{%- set here = page.url | cleanUrl -%}
<header class="site-header" id="siteHeader">
  <div class="wrap-header nav">
    {% include "partials/logo.njk" %}
    <nav class="links" id="navlinks" aria-label="منوی اصلی">
      {%- for item in site.nav %}
      {%- set isActive = (item.href == here) or (item.href != "/" and here.startsWith(item.href)) %}
      <a{% if isActive %} class="active" aria-current="page"{% endif %} href="{{ item.href }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>
    <div class="nav-actions">
      <label class="search">
        {{ icon("search") }}
        <input id="search" type="search" placeholder="جستجو در محصولات..." aria-label="جستجو در محصولات">
      </label>
      <?php if ($me = current_user()): ?>
      <a class="pill pill-ghost nav-account{{ ' is-active' if here.startsWith('/account/') }}" href="/account/" title="<?= e($me['email']) ?>">{{ icon("user") }}<span>حساب من</span></a>
      <?php else: ?>
      <a class="pill pill-ghost nav-account{{ ' is-active' if here.startsWith('/account/') }}" href="/account/login/">{{ icon("user") }}<span>ورود / ثبت‌نام</span></a>
      <?php endif ?>
      <a class="btn-cta" href="/contact/" data-quote-open><span>درخواست استعلام قیمت</span><i class="btn-dot">{{ icon("arrow") }}</i></a>
      <button class="hamb" id="hamb" type="button" aria-label="باز کردن منو" aria-controls="navlinks" aria-expanded="false">{{ icon("menu") }}</button>
    </div>
  </div>
</header>
