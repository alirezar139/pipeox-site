---
layout: layouts/base.njk
hasForm: true
bodyClass: is-home
---
{#- Homepage — built 1:1 from design/mockup-home.png (1536px reference).
    Photographic artwork is cut from the mockup by scripts/extract-mockup-assets.mjs. -#}
{%- from "partials/icons.njk" import icon -%}
{%- set compactForm = true -%}

{#- ═════════ HERO ═════════ -#}
<section class="hero">
  <div class="hero-photo" aria-hidden="true"><img src="/assets/img/home/hero-pipes.jpg" alt="" width="1490" height="856" fetchpriority="high" eleventy:ignore></div>
  <div class="hero-stripes" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="wrap-header hero-grid">
    {% include "partials/quote-form.njk" %}
    <div class="hero-copy">
      <p class="kicker">{{ home.hero.kicker }}</p>
      <h1>{{ home.hero.title }}<br><span class="accent">{{ home.hero.titleAccent }}</span></h1>
      <p class="hero-text">{{ home.hero.text }}</p>
      <div class="actions">
        <a class="pill pill-orange" href="/products/">{{ icon("arrow") }}<span>مشاهده محصولات</span></a>
        <a class="pill pill-ghost" href="/about/">{{ icon("play") }}<span>درباره ما</span></a>
      </div>
    </div>
  </div>
</section>

{#- ═════════ BAND: stats · product orbit · intro ═════════ -#}
<section class="band" aria-label="محصولات و آمار">
  <div class="wrap-wide band-grid">
    <ul class="stats reveal">
      {%- for s in home.stats %}
      <li>
        <span class="stat-icon">{{ icon(s.icon) }}</span>
        <div><b>+<span class="count" data-to="{{ s.value }}">{{ s.value | faNum }}</span></b><small>{{ s.label }}</small></div>
      </li>
      {%- endfor %}
    </ul>

    <div class="orbit-art">
      <img src="/assets/img/home/orbit-art.jpg" alt="" width="1720" height="596" loading="lazy" eleventy:ignore>
      <div class="orbit-glint" aria-hidden="true"></div>
      {%- for p in products %}
      <a class="orbit-label label-{{ p.orbit }}" href="/products/{{ p.slug }}/">
        <b>{{ p.shortTitle }}</b>
        <small>مشاهده بیشتر {{ icon("chevron") }}</small>
      </a>
      {%- endfor %}
    </div>

    <div class="band-intro reveal">
      <h2>{{ home.showcase.title }}</h2>
      <p>{{ home.showcase.text }}</p>
      <a class="pill pill-outline" href="/products/">{{ icon("doc") }}<span>مشاهده کاتالوگ کامل</span></a>
    </div>
  </div>
</section>

{#- ═════════ TILES: news · features · projects ═════════ -#}
<section class="tiles">
  <div class="wrap-wide tiles-grid">
    {%- set latest = (collections.insights | reverse)[0] %}
    <article class="tile tile-news reveal">
      <header class="tile-head">
        <h2>آخرین اخبار و اطلاعیه‌ها</h2>
        <a class="link-more" href="/insights/">{{ icon("arrow") }}مشاهده همه</a>
      </header>
      {%- if latest %}
      <a class="news-item" href="{{ latest.url }}">
        <span class="news-thumb"><img src="/assets/img/home/news.jpg" alt="" width="208" height="184" loading="lazy" eleventy:ignore></span>
        <span class="news-body">
          <b>{{ latest.data.title }}</b>
          <small><time datetime="{{ latest.date | isoDate }}">{{ latest.date | faDateShort }}</time>{{ icon("calendar") }}</small>
        </span>
      </a>
      {%- endif %}
    </article>

    <div class="tile tile-features reveal">
      {%- for f in home.features %}
      <div class="feature">
        <span class="feature-icon">{{ icon(f.icon) }}</span>
        <b>{{ f.title }}</b>
        <small>{{ f.text }}</small>
      </div>
      {%- endfor %}
    </div>

    <article class="tile tile-projects reveal">
      <div class="projects-copy">
        <h2>{{ home.projects.title }}</h2>
        <p>{{ home.projects.text }}</p>
        <a class="link-more link-underline" href="/projects/">{{ icon("arrow-right") }}مشاهده پروژه‌ها</a>
      </div>
      <a class="projects-media" href="{{ home.projects.video or '/projects/' }}"{% if home.projects.video %} target="_blank" rel="noopener"{% endif %} aria-label="{{ home.projects.title }}">
        <img src="/assets/img/home/projects.jpg" alt="" width="654" height="258" loading="lazy" eleventy:ignore>
      </a>
    </article>
  </div>
</section>
