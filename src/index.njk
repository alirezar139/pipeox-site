{#- ═════════ BAND: stats · product orbit · intro ═════════ -#}
<section class="band" aria-label="محصولات و آمار">
  <div class="wrap-wide band-grid">
    <ul class="stats reveal">
      <?php foreach (s('stats', []) as $st): ?>
      <li>
        <span class="stat-icon"><?= icon($st['icon'] ?? 'check-circle') ?></span>
        <div><b>+<span class="count" data-to="<?= (int)$st['value'] ?>"><?= fa_num($st['value']) ?></span></b><small><?= e($st['label']) ?></small></div>
      </li>
      <?php endforeach ?>
    </ul>

    <div class="orbit-art">
      <img src="/assets/img/home/orbit-art.jpg" alt="" width="1720" height="596" loading="lazy">
      <div class="orbit-glint" aria-hidden="true"></div>
      <?php foreach (products() as $p): if (!in_array($p['orbit'], ['a', 'b', 'c', 'd'], true)) continue; ?>
      <a class="orbit-label label-<?= $p['orbit'] ?>" href="/products/<?= e($p['slug']) ?>/">
        <b><?= e($p['short_title'] ?: $p['title']) ?></b>
        <small>مشاهده بیشتر {{ icon("chevron") }}</small>
      </a>
      <?php endforeach ?>
    </div>

    <div class="band-intro reveal">
      <h2><?= se('showcase.title') ?></h2>
      <p><?= se('showcase.text') ?></p>
      <a class="pill pill-outline" href="/products/">{{ icon("doc") }}<span>مشاهده کاتالوگ کامل</span></a>
    </div>
  </div>
</section>

{#- ═════════ TILES: news · features · projects ═════════ -#}
<section class="tiles">
  <div class="wrap-wide tiles-grid">
    <article class="tile tile-news reveal">
