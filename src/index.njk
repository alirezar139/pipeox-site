      <?php $video = (string)s('projects.video'); ?>
      <a class="projects-media" href="<?= e($video ?: '/projects/') ?>"<?= $video ? ' target="_blank" rel="noopener"' : '' ?> aria-label="<?= se('projects.title') ?>">
        <img src="/assets/img/home/projects.jpg" alt="" width="654" height="258" loading="lazy">
      </a>
