        <span class="news-body">
          <b><?= e($latest['title']) ?></b>
          <small><time datetime="<?= e($latest['published_at']) ?>"><?= fa_date($latest['published_at'], true) ?></time>{{ icon("calendar") }}</small>
        </span>
      </a>
      <?php endif ?>
    </article>

    <div class="tile tile-features reveal">
