        <h2>آخرین اخبار و اطلاعیه‌ها</h2>
        <a class="link-more" href="/insights/">{{ icon("arrow") }}مشاهده همه</a>
      </header>
      <?php if ($latest = articles(1)[0] ?? null): ?>
      <a class="news-item" href="/insights/<?= e($latest['slug']) ?>/">
