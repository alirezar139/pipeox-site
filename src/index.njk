        <small><?= e($f['text']) ?></small>
      </div>
      <?php endforeach ?>
    </div>

    <article class="tile tile-projects reveal">
      <div class="projects-copy">
        <h2><?= se('projects.title') ?></h2>
        <p><?= se('projects.text') ?></p>
